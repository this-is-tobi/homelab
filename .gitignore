# Ansible vault password (local only, never commit)
.vault_password

# Kubernetes access files
auth/
htpasswd

# K3s secrets fetched by Ansible
ansible/inventory/group_vars/.k3sCaData
ansible/inventory/group_vars/.k3sToken

# Passwords generated by Ansible roles (pihole, wireguard, pi setup, ...)
ansible/inventory/group_vars/.*_password

# Homelab folder with ovpn & ssh files
ansible/secrets/

# Environment files
.env

# Common
.DS_Store

# Sops (plus the temp files run.sh's fail-safe decrypt/encrypt may leave
# behind if interrupted: <name>.dec.yaml.XXXXXX / <name>.enc.yaml.XXXXXX)
*.dec.yaml
*.dec.yaml.*
*.enc.yaml.*

# Helm charts (packaged or source)
**/charts/
**/tmpcharts*/

# Helm secret local values
**/secret-values.yaml

# Local backup files
backups/

# Local-only notes (kept out of the repo deliberately)
.local/
