services:
  pihole:
    container_name: pihole
    image: docker.io/pihole/pihole:{{ pihole.version }}
    ports:
      - 53:53/tcp
      - 53:53/udp
      - 5353:80/tcp
      # - 67:67/udp # Only required if you are using Pi-hole as your DHCP server
    env_file:
      - .env.pihole
    # Pi-hole v6: settings are FTLCONF_<section>_<key> (pihole.toml keys, dots
    # as underscores). The v5 names (PIHOLE_DNS_, DNSSEC, REV_SERVER*, ...)
    # are silently ignored by the v6 image.
    environment:
      TZ: 'Europe/Paris'
      FTLCONF_dns_listeningMode: all
      # Address returned for pi.hole / the host itself (was FTLCONF_LOCAL_IPV4):
      # behind the docker bridge FTL would otherwise answer with the bridge IP.
      FTLCONF_dns_reply_host_force4: "true"
      FTLCONF_dns_reply_host_IPv4: {{ gatewayIp }}
      FTLCONF_dns_upstreams: 9.9.9.9;9.9.9.10
      FTLCONF_dns_dnssec: "true"
      FTLCONF_dns_bogusPriv: "true"
      FTLCONF_dns_domainNeeded: "true"
      # <enabled>,<cidr>,<server>,<domain> — conditional forwarding of the LAN
      # reverse zone / local domain to the router.
      FTLCONF_dns_revServers: "true,192.168.1.0/24,192.168.1.1,{{ localRootDomain }}"
      FTLCONF_dhcp_active: "false"
      # FTLCONF_dhcp_start: 192.168.1.10
      # FTLCONF_dhcp_end: 192.168.1.255
      # FTLCONF_dhcp_router: 192.168.1.1
      # v6 does not read /etc/dnsmasq.d/ unless told to — required for the
      # local-domain records this role drops in etc-dnsmasq.d.
      FTLCONF_misc_etc_dnsmasq_d: "true"
      FTLCONF_webserver_interface_boxed: "true"
      FTLCONF_webserver_interface_theme: default-dark
    volumes:
      - './.pihole/etc-pihole:/etc/pihole'
      - './.pihole/etc-dnsmasq.d:/etc/dnsmasq.d'
    # cap_add:
    #   - NET_ADMIN # Required if you are using Pi-hole as your DHCP server, else not needed
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: 256M
    networks:
      - homelab

networks:
  homelab:
    driver: bridge
