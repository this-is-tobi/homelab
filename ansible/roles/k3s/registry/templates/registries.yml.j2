mirrors:
  {{ harbor.domain }}:
    endpoint:
      - "https://{{ harbor.domain }}"
configs:
  # k3s keys `configs` by registry host[:port] — NOT by URL.
  "{{ harbor.domain }}":
    auth:
      username: {{ harbor.username | to_json }}
      password: {{ harbor.password | to_json }}
#    tls:
#      cert_file: # path to the cert file used in the registry
#      key_file:  # path to the key file used in the registry
#      ca_file:   # path to the ca file used in the registry
